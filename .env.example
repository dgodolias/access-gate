# access-gate — environment variables (copy to .env.local; never commit values)

# The shared password. Set → gate on. Unset or empty → gate off, zero overhead.
ACCESS_GATE_PASSWORD=

# Optional. During a rotation, sessions signed by this previous password stay
# valid; only ACCESS_GATE_PASSWORD is accepted on the login form. Remove it once
# every visitor has re-logged in (default session TTL is 8 h).
ACCESS_GATE_PREVIOUS_PASSWORD=

# Optional. Sign sessions with an independent secret instead of the password.
# With this set, changing the password does NOT log everyone out.
ACCESS_GATE_SECRET=

# Optional. Fail closed: respond 503 instead of passing through when the gate
# is active in production but ACCESS_GATE_PASSWORD is missing. Value: 1
ACCESS_GATE_REQUIRED=

# Optional. Comma-separated paths that bypass the gate. Globs: * = one path
# segment, ** = any depth. Example: /api/health,/api/cron/*
ACCESS_GATE_EXEMPT=

# Optional. Static assets the login page itself may load (e.g. /logo.svg).
ACCESS_GATE_PUBLIC_ASSETS=

# Optional. Environments in which the gate is active (from VERCEL_ENV, falling
# back to NODE_ENV). Default: production,preview
ACCESS_GATE_ENVIRONMENTS=

# Optional. Gate regardless of environment (non-Vercel hosts). Value: 1
ACCESS_GATE_ALWAYS=

# Optional. Login route. Default: /_access
ACCESS_GATE_PATH=

# Optional. Base cookie name (the __Host- prefix is added on HTTPS). Default: access_gate_session
ACCESS_GATE_COOKIE=

# Optional. Session lifetime in seconds, capped at 30 days. Default: 28800 (8 h)
ACCESS_GATE_TTL=

# Optional. Path prefixes that get a JSON 401 instead of the HTML page. Default: /api
ACCESS_GATE_API_PATHS=

# Optional. Built-in look: dark | paper. Default: dark
ACCESS_GATE_PRESET=

# Optional. lang attribute of the login page. Default: en
ACCESS_GATE_LANG=
